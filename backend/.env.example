# Leave DATABASE_URL unset for the ephemeral SQLite demo.
# Set a private connection URL only when using an external database.
# DATABASE_URL=

# Set only on the backend if Gemini assistant chat is needed.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Replace with the exact deployed frontend origin in Render.
# Local development defaults are configured in backend/app/main.py.
# FRONTEND_ORIGIN=
